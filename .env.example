# ---------------------------------------------------------------------------
# MachInfo configuration (copy to .env.local). Server-side only unless NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Public site URL for metadata, sitemap and robots (optional on Vercel — falls
# back to the production domain automatically).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Data provider: "demo" (default). Add your own provider in lib/data/index.ts
# (REST / GraphQL / Supabase / Postgres) and select it here.
# MACHINFO_DATA_PROVIDER=demo
