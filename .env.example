# ---------------------------------------------------------------------------
# FarmInfo configuration (copy to .env.local)
# All variables below are read on the SERVER only. Never prefix secrets with
# NEXT_PUBLIC_ — that would ship them to the browser.
# ---------------------------------------------------------------------------

# Public site URL, used for metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Market data provider: "demo" (default when no key is set) or "agmarknet"
# MARKET_DATA_PROVIDER=agmarknet

# Free API key from https://www.data.gov.in (sign in → My Account → Generate API key).
# Setting it switches FarmInfo to live AGMARKNET mandi prices for Gujarat.
# DATA_GOV_IN_API_KEY=

# Optional overrides
# DATA_GOV_IN_BASE_URL=https://api.data.gov.in
# Default: "Current Daily Price of Various Commodities from Various Markets (Mandi)"
# DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# DATA_GOV_IN_STATE_FILTER_KEY=state.keyword
